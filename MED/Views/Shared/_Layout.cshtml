<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - MED</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/MED.styles.css"
          asp-append-version="true" />
</head>

<body>

    <header>

        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">

            <div class="container-fluid">

                <!-- Website Logo -->

                <a class="navbar-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    ANDtr
                </a>

                <!-- Mobile Navigation Button -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav flex-grow-1">

                        <!-- Home -->

                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>

                        </li>

                        <!-- About -->

                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="About">
                                About
                            </a>

                        </li>

                        <!-- Features -->

                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Features">
                                Features
                            </a>

                        </li>

                        <!-- Contact -->

                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Contact">
                                Contact
                            </a>

                        </li>

                        <!-- Employee Navigation -->

                        @if (User.IsInRole("Employee"))
                        {
                            <!-- Search Notices -->

                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-controller="Notices"
                                   asp-action="Index">
                                    Search Notices
                                </a>

                            </li>

                            <!-- Selected Notices -->

                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-controller="NoticeManagement"
                                   asp-action="Selected">
                                    Selected Notices
                                </a>

                            </li>

                            <!-- My Findings -->

                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-controller="Findings"
                                   asp-action="Index">
                                    My Findings
                                </a>

                            </li>
                        }

                        <!-- Customer Navigation -->

                        @if (User.IsInRole("Customer"))
                        {
                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-controller="Customer"
                                   asp-action="Index">
                                    Shared Findings
                                </a>

                            </li>
                        }

                        <!-- Privacy -->

                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Privacy">
                                Privacy
                            </a>

                        </li>

                    </ul>

                    <!-- Login / Logout Navigation -->

                    <ul class="navbar-nav">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- Logged In User -->

                            <li class="nav-item">

                                <span class="nav-link text-dark">

                                    @User.Identity.Name

                                    (@(User.IsInRole("Employee")
                                        ? "Employee"
                                        : "Customer"))

                                </span>

                            </li>

                            <!-- Logout -->

                            <li class="nav-item">

                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-outline-danger btn-sm mt-1">
                                        Logout
                                    </button>

                                </form>

                            </li>
                        }
                        else
                        {
                            <!-- Login -->

                            <li class="nav-item">

                                <a class="btn btn-primary btn-sm mt-1"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Login
                                </a>

                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>

    </header>

    <!-- Main Content -->

    <div class="container">

        <main role="main" class="pb-3">

            @RenderBody()

        </main>

    </div>

    <!-- Footer -->

    <footer class="border-top footer text-muted">

        <div class="container">

            &copy; 2026 - ANDtr -

            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">
                Privacy
            </a>

        </div>

    </footer>

    <!-- Scripts -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
