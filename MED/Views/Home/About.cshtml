@{
    ViewData["Title"] = "About";
}

<div class="container mt-5 mb-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold">About MED</h1>
        <p class="lead text-muted">
            Medical Device Safety and Recall Notice Platform
        </p>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">

            <h3>Who We Are</h3>

            <p>
                MED is a web-based platform designed to help
                organizations manage medical device safety
                alerts and recall notices efficiently.
            </p>

            <p>
                The system allows company employees to search
                for safety notices, review relevant information,
                organize notices, and record findings for
                future reference.
            </p>

        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">

            <h3>Our Purpose</h3>

            <p>
                Our purpose is to provide a simple and
                organized platform for managing medical
                device safety information.
            </p>

            <p>
                MED helps employees identify important
                safety notices and share relevant findings
                with customers.
            </p>

        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <h3>Our Project</h3>

            <p>
                This platform was developed as a university
                software engineering group project.
            </p>

            <p>
                The project focuses on improving the process
                of searching, reviewing, managing, and
                sharing medical device safety information.
            </p>

        </div>
    </div>

</div>