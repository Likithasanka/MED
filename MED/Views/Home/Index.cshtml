@{
    ViewData["Title"] = "Home";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ANDtr - Medical Device Safety Platform</title>

    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: Arial, sans-serif;
                background-color: #f4f7fb;
                color: #333;
            }

            /* Navigation Bar */
            header {
                background-color: #123b5d;
                color: white;
                padding: 20px 8%;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            nav a {
                color: white;
                text-decoration: none;
                margin-left: 25px;
            }

            nav a:hover {
                color: #45c4d9;
            }

            .login-btn {
                background-color: #159bb5;
                padding: 10px 20px;
                border-radius: 5px;
            }

            /* Home Section */
            .home {
                min-height: 450px;
                background-color: #dcecf5;
                display: flex;
                align-items: center;
                padding: 60px 30px;
            }

            .home-content {
                max-width: 650px;
            }

            .home h1 {
                font-size: 38px;
                color: #123b5d;
                margin-bottom: 20px;
            }

            .home p {
                font-size: 17px;
                line-height: 1.7;
                margin-bottom: 30px;
            }

            .start-btn {
                background-color: #159bb5;
                color: white;
                text-decoration: none;
                padding: 13px 25px;
                border-radius: 5px;
            }

            .start-btn:hover {
                background-color: #123b5d;
            }

            /* About Section */
            .about {
                text-align: center;
                padding: 60px 10%;
            }

            .about h2,
            .features h2,
            .contact h2 {
                color: #123b5d;
                margin-bottom: 20px;
            }

            .about p {
                line-height: 1.7;
                max-width: 750px;
                margin: auto;
            }

            /* Features Section */
            .features {
                background-color: #eaf2f7;
                padding: 60px 8%;
                text-align: center;
            }

            .feature-container {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 20px;
                margin-top: 30px;
            }

            .feature-box {
                background-color: white;
                padding: 30px 20px;
                border-radius: 8px;
                box-shadow: 0 2px 8px rgba(0,0,0,0.1);
                text-align: center;
            }

            .feature-box h3 {
                color: #159bb5;
                margin-bottom: 15px;
            }

            .feature-box p {
                line-height: 1.6;
            }

            /* Contact Section */
            .contact {
                text-align: center;
                padding: 50px;
            }

            /* Footer */
            footer {
                background-color: #123b5d;
                color: white;
                text-align: center;
                padding: 18px;
                padding-left: 30px;
            }

            /* Responsive Design */
            
                nav a {
                    margin: 5px;
                    display: inline-block;
                }

                .home h1 {
                    font-size: 28px;
                }

                .feature-container {
                    flex-direction: column;
                    align-items: center;
                }
            
    </style>
</head>

<body>

    <!-- Home Section -->
    <section class="home" id="home">

        <div class="home-content">

            <h1>
                Medical Device Safety & Recall Notice Platform
            </h1>

            <p>
                A smart platform to search, review and manage
                medical device safety and recall notices.
                Helping employees identify risks and share
                important findings with customers.
            </p>

            <a href="@Url.Action("Login", "Account")" class="start-btn">
                Get Started
            </a>

        </div>

    </section>

    <!-- About Section -->
    <section class="about" id="about">

        <h2>About Our Platform</h2>

        <p>
            ANDtr provides a platform for company employees
            to search medical device safety notices, review
            relevant information and manage risk analysis findings.
            Customers can also view shared findings and provide feedback.
        </p>

    </section>

    <!-- Features Section -->
    <section class="features" id="features">

        <h2>Our Features</h2>

        <div class="feature-container">

            <div class="feature-box">
                <h3>Notice Search</h3>
                <p>
                    Search medical device safety and recall notices easily.
                </p>
            </div>

            <div class="feature-box">
                <h3>Risk Analysis</h3>
                <p>
                    Review and organise relevant safety information.
                </p>
            </div>

            <div class="feature-box">
                <h3>Manage Findings</h3>
                <p>
                    Add comments and save important findings.
                </p>
            </div>

            <div class="feature-box">
                <h3>Share Findings</h3>
                <p>
                    Share findings with customers and receive feedback.
                </p>
            </div>

        </div>

    </section>

    <!-- Contact Section -->
    <section class="contact" id="contact">

        <h2>Contact Us</h2>

        <p>ANDtr - Medical Device Safety Platform</p>

    </section>

    <!-- Footer -->
    <footer>

        <p>&copy; 2026 ANDtr. All Rights Reserved.</p>

    </footer>

</body>
</html>