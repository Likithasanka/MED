@{
    ViewData["Title"] = "Contact";
}

<div class="container mt-5 mb-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold">Contact Us</h1>

        <p class="lead text-muted">
            Get in touch with the MED Project Team.
        </p>
    </div>

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4">

                    <h3>MED Project Team</h3>

                    <p>
                        MED is a university software
                        engineering project developed
                        to support medical device
                        safety and recall notice management.
                    </p>

                    <hr />

                    <h5>Project Name</h5>

                    <p>
                        Medical Device Safety and
                        Recall Notice Platform
                    </p>

                    <h5>Project Type</h5>

                    <p>
                        University Group Project
                    </p>

                    <h5>Developed For</h5>

                    <p>
                        ANDtr
                    </p>

                    <h5>Institution</h5>

                    <p>
                        CINEC Campus
                    </p>

                    <hr />

                    <p class="text-muted">
                        For project-related inquiries,
                        please contact the project team
                        through the university's
                        official communication channels.
                    </p>

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-primary">

                        Back to Home

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>