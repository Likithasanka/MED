@{
    ViewData["Title"] = "Features";
}

<div class="container mt-5 mb-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold">Our Features</h1>

        <p class="lead text-muted">
            Explore the main features of the MED Platform.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h4>User Login</h4>
                    <p>
                        Secure login functionality for
                        company employees and customers
                        with role-based access.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h4>Search Notices</h4>
                    <p>
                        Search medical device safety
                        alerts and recall notices
                        using relevant keywords.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h4>View Notice Details</h4>
                    <p>
                        View important information
                        related to medical device
                        safety and recall notices.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h4>Manage Selected Notices</h4>
                    <p>
                        Select and organize relevant
                        notices for risk reviews.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h4>Manage Findings</h4>
                    <p>
                        Save, update, and manage
                        findings related to
                        medical device safety reviews.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h4>Customer Collaboration</h4>
                    <p>
                        Share findings with customers
                        and allow them to review
                        information and provide feedback.
                    </p>
                </div>
            </div>
        </div>

    </div>

</div>