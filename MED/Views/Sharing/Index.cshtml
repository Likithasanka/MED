@model List<MedUser>

@{
    ViewData["Title"] = "Share Finding";
}

<h2>Share Finding</h2>

<form asp-action="Share" method="post">

    @Html.AntiForgeryToken()

    <input type="hidden"
           name="findingId"
           value="@ViewBag.FindingId" />

    <select name="customerId"
            class="form-select mb-2"
            required>

        @foreach (var u in Model)
        {
            <option value="@u.Id">
                @u.Name (@u.Email)
            </option>
        }

    </select>

    <button class="btn btn-primary">
        Share
    </button>

</form>
