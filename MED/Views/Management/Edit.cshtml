@model Finding

@{
    ViewData["Title"] = "Edit Finding";
}

<h2>Edit Finding</h2>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" name="id" value="@Model.Id" />

    <label>Title</label>
    <input name="title"
           value="@Model.Title"
           maxlength="120"
           required
           class="form-control mb-2" />

    <label>Summary</label>
    <textarea name="summary"
              maxlength="3000"
              class="form-control mb-2">@Model.Summary</textarea>

    <button class="btn btn-primary">
        Save Changes
    </button>
</form>

<form asp-action="Delete"
      method="post"
      onsubmit="return confirm('Delete this finding and its shares?')">

    @Html.AntiForgeryToken()

    <input type="hidden" name="id" value="@Model.Id" />

    <button class="btn btn-danger mt-3">
        Delete Finding
    </button>
</form>