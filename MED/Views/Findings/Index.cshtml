@model List<Finding>

@{
    ViewData["Title"] = "My Findings";
}

<h2>My Findings</h2>

@foreach (var f in Model)
{
    <div class="card mb-2">
        <div class="card-body">
            <a asp-action="Details" asp-route-id="@f.Id">@f.Title</a>
            <small>@f.UpdatedAt.ToLocalTime()</small>
        </div>
    </div>
}