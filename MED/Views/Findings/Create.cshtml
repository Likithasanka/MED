@{
    var review = (Review)ViewBag.Review;
    ViewData["Title"] = "Save Finding";
}

<h2>Save Finding for @review.Title</h2>

<form method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" name="reviewId" value="@review.Id" />

    <label>Finding title</label>
    <input name="title" required maxlength="120" class="form-control mb-2" />

    <label>Summary</label>
    <textarea name="summary" maxlength="3000" class="form-control mb-2"></textarea>

    <button class="btn btn-primary">Save Finding</button>
</form>